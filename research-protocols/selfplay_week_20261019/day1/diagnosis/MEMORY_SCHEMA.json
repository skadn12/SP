{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gxy-selfplay:day1:diagnosis:memory-schema:1.0",
  "title": "Train-only challenger weakness memory and diagnostic records",
  "description": "Schemas for strict train.feedback artifacts. Semantic/root/lineage checks additionally required; schema declarations alone cannot prove data isolation.",
  "oneOf": [
    {
      "$ref": "#/$defs/memory_snapshot"
    },
    {
      "$ref": "#/$defs/solver_trace"
    },
    {
      "$ref": "#/$defs/postgold_evaluation"
    }
  ],
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "train_provenance": {
      "type": "object",
      "properties": {
        "split": {
          "const": "train"
        },
        "namespace": {
          "const": "train.feedback"
        },
        "root_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "family_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "split",
        "namespace",
        "root_id",
        "family_id",
        "source_id",
        "source_sha256"
      ],
      "additionalProperties": false
    },
    "evidence_ref": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scene_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "turn_start": {
          "type": "integer",
          "minimum": 0
        },
        "turn_end": {
          "type": "integer",
          "minimum": 0
        },
        "speaker": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_id",
        "source_sha256",
        "scene_id",
        "turn_start",
        "turn_end",
        "speaker",
        "quote"
      ],
      "additionalProperties": false
    },
    "content_gate": {
      "type": "object",
      "properties": {
        "decision": {
          "const": "PASS"
        },
        "score_used": {
          "const": false
        },
        "completed_before_solver_scoring": {
          "const": true
        },
        "record": {
          "$ref": "#/$defs/artifact_ref"
        }
      },
      "required": [
        "decision",
        "score_used",
        "completed_before_solver_scoring",
        "record"
      ],
      "additionalProperties": false
    },
    "diagnostic_item": {
      "type": "object",
      "properties": {
        "content_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "judgment": {
          "type": "string",
          "enum": [
            "supported",
            "refuted",
            "uncertain",
            "ordering_occurrence"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_ref"
          },
          "minItems": 0
        },
        "brief_basis": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "content_id",
        "judgment",
        "evidence_refs",
        "brief_basis"
      ],
      "additionalProperties": false
    },
    "diagnostic_pair": {
      "type": "object",
      "properties": {
        "first_content_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "second_content_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "basis": {
          "type": "string",
          "enum": [
            "source_appearance_order",
            "uncertain"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_ref"
          },
          "minItems": 0
        },
        "brief_basis": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "first_content_id",
        "second_content_id",
        "basis",
        "evidence_refs",
        "brief_basis"
      ],
      "additionalProperties": false
    },
    "solver_trace": {
      "type": "object",
      "properties": {
        "document_type": {
          "const": "solver_diagnostic_trace"
        },
        "schema_version": {
          "const": "1.0"
        },
        "trace_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "$ref": "#/$defs/train_provenance"
        },
        "question_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "task_type": {
          "type": "string",
          "enum": [
            "multi_select",
            "ordering"
          ]
        },
        "public_question": {
          "$ref": "#/$defs/artifact_ref"
        },
        "source_input": {
          "$ref": "#/$defs/artifact_ref"
        },
        "display_mapping": {
          "$ref": "#/$defs/artifact_ref"
        },
        "protocol": {
          "$ref": "#/$defs/artifact_ref"
        },
        "gold_visible": {
          "const": false
        },
        "author_evidence_visible": {
          "const": false
        },
        "output_budget_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "actual_output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "per_item": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic_item"
          },
          "minItems": 1
        },
        "order_pairs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic_pair"
          },
          "minItems": 0
        },
        "final_prediction_content_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "format_valid": {
          "type": "boolean"
        },
        "raw_response": {
          "$ref": "#/$defs/artifact_ref"
        }
      },
      "required": [
        "document_type",
        "schema_version",
        "trace_id",
        "request_id",
        "created_at",
        "model_id",
        "provenance",
        "question_id",
        "task_type",
        "public_question",
        "source_input",
        "display_mapping",
        "protocol",
        "gold_visible",
        "author_evidence_visible",
        "output_budget_tokens",
        "actual_output_tokens",
        "per_item",
        "order_pairs",
        "final_prediction_content_ids",
        "format_valid",
        "raw_response"
      ],
      "additionalProperties": false
    },
    "failure_case": {
      "type": "object",
      "properties": {
        "failure_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "question_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "$ref": "#/$defs/train_provenance"
        },
        "content_gate": {
          "$ref": "#/$defs/content_gate"
        },
        "format_valid": {
          "const": true
        },
        "full_evidence_visible": {
          "const": true
        },
        "observed_errors": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "obs.mc.false_positive",
              "obs.mc.false_negative",
              "obs.mc.over_selection",
              "obs.mc.under_selection",
              "obs.order.within_scene_pair",
              "obs.order.across_scene_pair",
              "obs.order.repeated_report_occurrence",
              "obs.display.position_sensitivity"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_ref"
          },
          "minItems": 1
        },
        "direct_answer_record": {
          "$ref": "#/$defs/artifact_ref"
        },
        "diagnostic_trace": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifact_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "postgold_evaluation": {
          "$ref": "#/$defs/artifact_ref"
        },
        "repeat_aggregation": {
          "type": "object",
          "properties": {
            "protocol": {
              "$ref": "#/$defs/artifact_ref"
            },
            "valid_calls": {
              "type": "integer",
              "minimum": 1
            },
            "content_failures": {
              "type": "integer",
              "minimum": 1
            },
            "failed_display_mappings": {
              "type": "integer",
              "minimum": 0
            },
            "total_display_mappings": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "protocol",
            "valid_calls",
            "content_failures",
            "failed_display_mappings",
            "total_display_mappings"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "failure_id",
        "question_id",
        "model_id",
        "provenance",
        "content_gate",
        "format_valid",
        "full_evidence_visible",
        "observed_errors",
        "evidence_refs",
        "direct_answer_record",
        "diagnostic_trace",
        "postgold_evaluation",
        "repeat_aggregation"
      ],
      "additionalProperties": false
    },
    "competing_explanation": {
      "type": "object",
      "properties": {
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "not_tested",
            "supported",
            "weakened",
            "unresolved"
          ]
        },
        "probe_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
          },
          "minItems": 0
        },
        "interpretation_limit": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "explanation",
        "status",
        "probe_ids",
        "interpretation_limit"
      ],
      "additionalProperties": false
    },
    "probe": {
      "type": "object",
      "properties": {
        "probe_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "type": {
          "type": "string",
          "enum": [
            "option_permutation",
            "semantic_paraphrase",
            "evidence_hint",
            "minimal_relation_contrast",
            "new_root_transfer"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/train_provenance"
        },
        "compared_model_id": {
          "type": "string",
          "minLength": 1
        },
        "frozen_protocol": {
          "$ref": "#/$defs/artifact_ref"
        },
        "record": {
          "$ref": "#/$defs/artifact_ref"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "supports_hypothesis",
            "weakens_hypothesis",
            "inconclusive"
          ]
        },
        "confounds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "probe_id",
        "type",
        "provenance",
        "compared_model_id",
        "frozen_protocol",
        "record",
        "outcome",
        "confounds"
      ],
      "additionalProperties": false
    },
    "target_design": {
      "type": "object",
      "properties": {
        "design_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "target_relation": {
          "type": "string",
          "minLength": 1
        },
        "needed_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "distractor_or_order_mechanism": {
          "type": "string",
          "minLength": 1
        },
        "new_fact_or_root_requirement": {
          "type": "string",
          "minLength": 1
        },
        "ordering_definition": {
          "type": "string",
          "enum": [
            "source_appearance_order",
            "not_applicable"
          ]
        },
        "avoid_shortcuts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "content_gate_before_score": {
          "const": true
        }
      },
      "required": [
        "design_id",
        "target_relation",
        "needed_evidence",
        "distractor_or_order_mechanism",
        "new_fact_or_root_requirement",
        "ordering_definition",
        "avoid_shortcuts",
        "content_gate_before_score"
      ],
      "additionalProperties": false
    },
    "attempt": {
      "type": "object",
      "properties": {
        "attempt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "design_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_ledger": {
          "$ref": "#/$defs/artifact_ref"
        },
        "all_attempts_preserved": {
          "const": true
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "admitted_count": {
          "type": "integer",
          "minimum": 0
        },
        "rejected_count": {
          "type": "integer",
          "minimum": 0
        },
        "held_count": {
          "type": "integer",
          "minimum": 0
        },
        "score_based_filtering": {
          "const": false
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "attempt_id",
        "design_id",
        "model_id",
        "candidate_ledger",
        "all_attempts_preserved",
        "candidate_count",
        "admitted_count",
        "rejected_count",
        "held_count",
        "score_based_filtering",
        "input_tokens",
        "output_tokens"
      ],
      "additionalProperties": false
    },
    "new_question_result": {
      "type": "object",
      "properties": {
        "result_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "provenance": {
          "$ref": "#/$defs/train_provenance"
        },
        "new_family_for_memory": {
          "const": true
        },
        "before_model_id": {
          "type": "string",
          "minLength": 1
        },
        "after_model_id": {
          "type": "string",
          "minLength": 1
        },
        "same_protocol": {
          "const": true
        },
        "before_exact_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "after_exact_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "record": {
          "$ref": "#/$defs/artifact_ref"
        },
        "interpretation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "result_id",
        "provenance",
        "new_family_for_memory",
        "before_model_id",
        "after_model_id",
        "same_protocol",
        "before_exact_rate",
        "after_exact_rate",
        "record",
        "interpretation"
      ],
      "additionalProperties": false
    },
    "cause": {
      "type": "object",
      "properties": {
        "cause_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "mechanism_tag": {
          "type": "string",
          "enum": [
            "hyp.binding.role_action_object",
            "hyp.binding.state_revision",
            "hyp.binding.condition_conjunction",
            "hyp.evidence.retrieval",
            "hyp.reasoning.relation",
            "hyp.shortcut.lexical"
          ]
        },
        "mechanism": {
          "type": "string",
          "minLength": 1
        },
        "confidence_status": {
          "type": "string",
          "enum": [
            "hypothesis",
            "reproduced",
            "improving",
            "recurred",
            "retired"
          ]
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "supporting_failure_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "supporting_root_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "supporting_family_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_ref"
          },
          "minItems": 1
        },
        "competing_explanations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/competing_explanation"
          },
          "minItems": 1
        },
        "probe_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "targeted_designs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target_design"
          },
          "minItems": 1
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attempt"
          },
          "minItems": 0
        },
        "new_question_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/new_question_result"
          },
          "minItems": 0
        },
        "state_history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "model_id": {
                "type": "string",
                "minLength": 1
              },
              "from": {
                "type": "string",
                "enum": [
                  "none",
                  "hypothesis",
                  "reproduced",
                  "improving",
                  "recurred",
                  "retired"
                ]
              },
              "to": {
                "type": "string",
                "enum": [
                  "hypothesis",
                  "reproduced",
                  "improving",
                  "recurred",
                  "retired"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "record": {
                "$ref": "#/$defs/artifact_ref"
              }
            },
            "required": [
              "at",
              "model_id",
              "from",
              "to",
              "reason",
              "record"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "cause_id",
        "mechanism_tag",
        "mechanism",
        "confidence_status",
        "model_version",
        "supporting_failure_ids",
        "supporting_root_ids",
        "supporting_family_keys",
        "evidence_refs",
        "competing_explanations",
        "probe_ids",
        "targeted_designs",
        "attempts",
        "new_question_results",
        "state_history",
        "limitations"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "confidence_status": {
                "enum": [
                  "reproduced",
                  "improving",
                  "recurred"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "supporting_root_ids": {
                "minItems": 3
              },
              "supporting_family_keys": {
                "minItems": 3
              },
              "probe_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "confidence_status": {
                "const": "improving"
              }
            }
          },
          "then": {
            "properties": {
              "new_question_results": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "memory_snapshot": {
      "type": "object",
      "properties": {
        "document_type": {
          "const": "challenger_weakness_memory"
        },
        "schema_version": {
          "const": "1.0"
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "const": "train.feedback"
        },
        "audience": {
          "const": "challenger"
        },
        "taxonomy": {
          "$ref": "#/$defs/artifact_ref"
        },
        "allowed_train_roots_manifest": {
          "$ref": "#/$defs/artifact_ref"
        },
        "parent_snapshot": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifact_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "frequency_unit": {
          "const": "unique(root_id,family_id)"
        },
        "reproduction_min_distinct_roots": {
          "const": 3
        },
        "failure_cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/failure_case"
          },
          "minItems": 0
        },
        "probes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/probe"
          },
          "minItems": 0
        },
        "causes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cause"
          },
          "minItems": 0
        },
        "eval_error_feedback_included": {
          "const": false
        },
        "known_limits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "document_type",
        "schema_version",
        "snapshot_id",
        "created_at",
        "model_id",
        "namespace",
        "audience",
        "taxonomy",
        "allowed_train_roots_manifest",
        "parent_snapshot",
        "frequency_unit",
        "reproduction_min_distinct_roots",
        "failure_cases",
        "probes",
        "causes",
        "eval_error_feedback_included",
        "known_limits"
      ],
      "additionalProperties": false
    },
    "postgold_item": {
      "type": "object",
      "properties": {
        "content_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "gold_selected": {
          "type": "boolean"
        },
        "predicted_selected": {
          "type": "boolean"
        },
        "classification": {
          "type": "string",
          "enum": [
            "TP",
            "FP",
            "FN",
            "TN"
          ]
        },
        "reference_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_ref"
          },
          "minItems": 1
        }
      },
      "required": [
        "content_id",
        "gold_selected",
        "predicted_selected",
        "classification",
        "reference_evidence"
      ],
      "additionalProperties": false
    },
    "postgold_pair": {
      "type": "object",
      "properties": {
        "first_content_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "second_content_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "scene_relation": {
          "type": "string",
          "enum": [
            "within_scene",
            "across_scene"
          ]
        },
        "predicted_correct": {
          "type": "boolean"
        },
        "reference_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_ref"
          },
          "minItems": 1
        }
      },
      "required": [
        "first_content_id",
        "second_content_id",
        "scene_relation",
        "predicted_correct",
        "reference_evidence"
      ],
      "additionalProperties": false
    },
    "postgold_evaluation": {
      "type": "object",
      "properties": {
        "document_type": {
          "const": "postgold_diagnostic_evaluation"
        },
        "schema_version": {
          "const": "1.0"
        },
        "evaluation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "evaluator_id": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "$ref": "#/$defs/train_provenance"
        },
        "question_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "task_type": {
          "type": "string",
          "enum": [
            "multi_select",
            "ordering"
          ]
        },
        "content_gate": {
          "$ref": "#/$defs/content_gate"
        },
        "frozen_solver_trace": {
          "$ref": "#/$defs/artifact_ref"
        },
        "solver_trace_committed_before_gold_read": {
          "const": true
        },
        "gold_reference": {
          "$ref": "#/$defs/artifact_ref"
        },
        "direct_answer_record": {
          "$ref": "#/$defs/artifact_ref"
        },
        "per_item": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/postgold_item"
          },
          "minItems": 0
        },
        "order_pairs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/postgold_pair"
          },
          "minItems": 0
        },
        "observed_errors": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "obs.mc.false_positive",
              "obs.mc.false_negative",
              "obs.mc.over_selection",
              "obs.mc.under_selection",
              "obs.order.within_scene_pair",
              "obs.order.across_scene_pair",
              "obs.order.repeated_report_occurrence",
              "obs.display.position_sensitivity"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "cause_hypotheses": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "hyp.binding.role_action_object",
              "hyp.binding.state_revision",
              "hyp.binding.condition_conjunction",
              "hyp.evidence.retrieval",
              "hyp.reasoning.relation",
              "hyp.shortcut.lexical"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "competing_explanations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/competing_explanation"
          },
          "minItems": 0
        },
        "explanation_faithfulness_assumed": {
          "const": false
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "document_type",
        "schema_version",
        "evaluation_id",
        "created_at",
        "evaluator_id",
        "model_id",
        "provenance",
        "question_id",
        "task_type",
        "content_gate",
        "frozen_solver_trace",
        "solver_trace_committed_before_gold_read",
        "gold_reference",
        "direct_answer_record",
        "per_item",
        "order_pairs",
        "observed_errors",
        "cause_hypotheses",
        "competing_explanations",
        "explanation_faithfulness_assumed",
        "limitations"
      ],
      "additionalProperties": false
    }
  }
}
