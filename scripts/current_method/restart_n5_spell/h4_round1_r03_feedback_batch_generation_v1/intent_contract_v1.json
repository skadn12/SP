{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "h4.r03.intent_contract.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intents"
  ],
  "properties": {
    "intents": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/intent"
      }
    }
  },
  "$defs": {
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intent_id": {
          "type": "string",
          "enum": [
            "I001",
            "I002",
            "I003"
          ]
        },
        "intent_type": {
          "type": "string",
          "enum": [
            "SUCCESSOR_FRONTIER",
            "COVERAGE_GAP",
            "FRESH_R03"
          ]
        },
        "status": {
          "enum": [
            "READY",
            "NO_SAFE_EVOLUTION"
          ]
        },
        "strategy": {
          "type": "string",
          "enum": [
            "CONSTRAINT_COMPOSITION",
            "CROSS_STAGE_EVIDENCE",
            "ENTITY_RELATION_BINDING",
            "MULTI_EVENT_DEPENDENCY",
            "OBSOLETE_VS_CURRENT",
            "STATE_UPDATE",
            "TEMPORAL_RELATION",
            "NO_SAFE_EVOLUTION"
          ]
        },
        "target_relation": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "source_feedback_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "coverage_gap_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "required_r03_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "reasoning_chain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "before_state",
            "trigger",
            "after_state"
          ],
          "properties": {
            "before_state": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "trigger": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "after_state": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        },
        "no_safe_reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "intent_id",
        "intent_type",
        "status",
        "strategy",
        "target_relation",
        "source_feedback_ids",
        "coverage_gap_ids",
        "required_r03_evidence",
        "reasoning_chain",
        "no_safe_reason"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "intent_type": {
                "const": "SUCCESSOR_FRONTIER"
              }
            }
          },
          "then": {
            "properties": {
              "intent_id": {
                "const": "I001"
              },
              "strategy": {
                "enum": [
                  "STATE_UPDATE",
                  "OBSOLETE_VS_CURRENT",
                  "CROSS_STAGE_EVIDENCE",
                  "MULTI_EVENT_DEPENDENCY",
                  "ENTITY_RELATION_BINDING",
                  "TEMPORAL_RELATION",
                  "CONSTRAINT_COMPOSITION",
                  "NO_SAFE_EVOLUTION"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "intent_type": {
                "const": "COVERAGE_GAP"
              }
            }
          },
          "then": {
            "properties": {
              "intent_id": {
                "const": "I002"
              },
              "strategy": {
                "enum": [
                  "CROSS_STAGE_EVIDENCE",
                  "MULTI_EVENT_DEPENDENCY",
                  "ENTITY_RELATION_BINDING",
                  "TEMPORAL_RELATION",
                  "CONSTRAINT_COMPOSITION",
                  "NO_SAFE_EVOLUTION"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "intent_type": {
                "const": "FRESH_R03"
              }
            }
          },
          "then": {
            "properties": {
              "intent_id": {
                "const": "I003"
              },
              "strategy": {
                "enum": [
                  "STATE_UPDATE",
                  "CROSS_STAGE_EVIDENCE",
                  "MULTI_EVENT_DEPENDENCY",
                  "ENTITY_RELATION_BINDING",
                  "TEMPORAL_RELATION",
                  "CONSTRAINT_COMPOSITION",
                  "NO_SAFE_EVOLUTION"
                ]
              },
              "source_feedback_ids": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "READY"
              }
            }
          },
          "then": {
            "properties": {
              "strategy": {
                "not": {
                  "const": "NO_SAFE_EVOLUTION"
                }
              },
              "target_relation": {
                "type": "string",
                "minLength": 1
              },
              "no_safe_reason": {
                "type": "null"
              },
              "reasoning_chain": {
                "properties": {
                  "before_state": {
                    "minItems": 1
                  },
                  "trigger": {
                    "minItems": 1
                  },
                  "after_state": {
                    "minItems": 1
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "strategy": {
                "const": "NO_SAFE_EVOLUTION"
              },
              "target_relation": {
                "type": "null"
              },
              "no_safe_reason": {
                "type": "string",
                "minLength": 1
              },
              "source_feedback_ids": {
                "maxItems": 0
              },
              "coverage_gap_ids": {
                "maxItems": 0
              },
              "required_r03_evidence": {
                "maxItems": 0
              },
              "reasoning_chain": {
                "properties": {
                  "before_state": {
                    "maxItems": 0
                  },
                  "trigger": {
                    "maxItems": 0
                  },
                  "after_state": {
                    "maxItems": 0
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "READY"
              },
              "intent_type": {
                "const": "SUCCESSOR_FRONTIER"
              }
            }
          },
          "then": {
            "properties": {
              "required_r03_evidence": {
                "minItems": 1
              },
              "source_feedback_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "READY"
              },
              "intent_type": {
                "const": "FRESH_R03"
              }
            }
          },
          "then": {
            "properties": {
              "required_r03_evidence": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "READY"
              },
              "intent_type": {
                "const": "COVERAGE_GAP"
              }
            }
          },
          "then": {
            "properties": {
              "coverage_gap_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  },
  "x-human-defined-slot-strategies": {
    "SUCCESSOR_FRONTIER": [
      "STATE_UPDATE",
      "OBSOLETE_VS_CURRENT",
      "CROSS_STAGE_EVIDENCE",
      "MULTI_EVENT_DEPENDENCY",
      "ENTITY_RELATION_BINDING",
      "TEMPORAL_RELATION",
      "CONSTRAINT_COMPOSITION"
    ],
    "COVERAGE_GAP": [
      "CROSS_STAGE_EVIDENCE",
      "MULTI_EVENT_DEPENDENCY",
      "ENTITY_RELATION_BINDING",
      "TEMPORAL_RELATION",
      "CONSTRAINT_COMPOSITION"
    ],
    "FRESH_R03": [
      "STATE_UPDATE",
      "CROSS_STAGE_EVIDENCE",
      "MULTI_EVENT_DEPENDENCY",
      "ENTITY_RELATION_BINDING",
      "TEMPORAL_RELATION",
      "CONSTRAINT_COMPOSITION"
    ]
  }
}
