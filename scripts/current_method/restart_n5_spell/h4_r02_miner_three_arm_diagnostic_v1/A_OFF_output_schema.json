{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intents"
  ],
  "properties": {
    "intents": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "intent_id",
          "intent_type",
          "reasoning_chain",
          "discriminative_variable",
          "candidate_question_types"
        ],
        "properties": {
          "intent_id": {
            "type": "string",
            "minLength": 1,
            "description": "A unique explicit ID for this intent."
          },
          "intent_type": {
            "type": "string",
            "enum": [
              "causal_chain",
              "decision_boundary",
              "necessary_evidence",
              "state_transition",
              "temporal_evolution"
            ]
          },
          "reasoning_chain": {
            "type": "object",
            "required": [
              "before_state",
              "trigger",
              "after_state"
            ],
            "properties": {
              "before_state": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": "Actual 1-based positions in the numbered current dialogue; groups must be non-empty and disjoint."
              },
              "trigger": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": "Actual 1-based positions in the numbered current dialogue; groups must be non-empty and disjoint."
              },
              "after_state": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": "Actual 1-based positions in the numbered current dialogue; groups must be non-empty and disjoint."
              }
            }
          },
          "discriminative_variable": {
            "type": "string",
            "minLength": 1,
            "description": "The concrete distinction to test, not a topic."
          },
          "candidate_question_types": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "enum": [
                "single_choice",
                "multi_select",
                "ordering"
              ]
            }
          }
        }
      }
    }
  }
}
