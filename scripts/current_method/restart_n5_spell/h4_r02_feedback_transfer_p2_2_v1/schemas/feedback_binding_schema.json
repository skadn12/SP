{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P2-2 feedback binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "change_from_source",
    "evidence_refs",
    "intent_id",
    "scope",
    "source_feedback_ids",
    "status",
    "target_distinction"
  ],
  "properties": {
    "intent_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PROPOSED_TRANSFER",
        "NO_SUPPORTED_TRANSFER"
      ]
    },
    "source_feedback_ids": {
      "type": "array",
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "target_distinction": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope": {
      "type": "string"
    },
    "change_from_source": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PROPOSED_TRANSFER"
          }
        }
      },
      "then": {
        "properties": {
          "source_feedback_ids": {
            "minItems": 1
          },
          "evidence_refs": {
            "minItems": 1
          },
          "target_distinction": {
            "minLength": 1,
            "pattern": "\\S"
          },
          "scope": {
            "minLength": 1,
            "pattern": "\\S"
          },
          "change_from_source": {
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "else": {
        "properties": {
          "source_feedback_ids": {
            "maxItems": 0
          },
          "evidence_refs": {
            "maxItems": 0
          },
          "target_distinction": {
            "const": ""
          },
          "scope": {
            "const": ""
          },
          "change_from_source": {
            "const": ""
          }
        }
      }
    }
  ]
}
