{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P2-2 Guided compiled brief before sidecar metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "brief_version",
    "root_id",
    "intent_id",
    "generation_source",
    "assigned_feedback_mode",
    "effective_feedback_mode",
    "fallback_reason"
  ],
  "properties": {
    "brief_version": {
      "type": "string"
    },
    "root_id": {
      "type": "string"
    },
    "intent_id": {
      "type": "string"
    },
    "generation_source": {
      "const": "contract_guided"
    },
    "assigned_feedback_mode": {
      "const": "P2_2_CONCRETE_TRANSFER"
    },
    "effective_feedback_mode": {
      "enum": [
        "CONCRETE_TRANSFER",
        "GENERIC_WRITER_GUIDANCE"
      ]
    },
    "fallback_reason": {
      "enum": [
        null,
        "NO_SUPPORTED_TRANSFER",
        "BINDING_MISSING",
        "BINDING_INVALID",
        "ENVELOPE_INVALID",
        "NO_ACTIVE_FEEDBACK"
      ]
    },
    "binding": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "P2-2 feedback binding v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_from_source",
        "evidence_refs",
        "intent_id",
        "scope",
        "source_feedback_ids",
        "status",
        "target_distinction"
      ],
      "properties": {
        "intent_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "PROPOSED_TRANSFER",
            "NO_SUPPORTED_TRANSFER"
          ]
        },
        "source_feedback_ids": {
          "type": "array",
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "target_distinction": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scope": {
          "type": "string"
        },
        "change_from_source": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "PROPOSED_TRANSFER"
              }
            }
          },
          "then": {
            "properties": {
              "source_feedback_ids": {
                "minItems": 1
              },
              "evidence_refs": {
                "minItems": 1
              },
              "target_distinction": {
                "minLength": 1,
                "pattern": "\\S"
              },
              "scope": {
                "minLength": 1,
                "pattern": "\\S"
              },
              "change_from_source": {
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "else": {
            "properties": {
              "source_feedback_ids": {
                "maxItems": 0
              },
              "evidence_refs": {
                "maxItems": 0
              },
              "target_distinction": {
                "const": ""
              },
              "scope": {
                "const": ""
              },
              "change_from_source": {
                "const": ""
              }
            }
          }
        }
      ]
    },
    "observation_cards": {
      "type": "array"
    },
    "current_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "turn_ref",
          "speaker",
          "text"
        ],
        "properties": {
          "turn_ref": {
            "type": "string"
          },
          "speaker": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "fixed_policy": {
      "type": "string"
    },
    "fact_rules": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "effective_feedback_mode": {
            "const": "CONCRETE_TRANSFER"
          }
        }
      },
      "then": {
        "required": [
          "binding",
          "observation_cards",
          "current_evidence",
          "fixed_policy",
          "fact_rules"
        ],
        "properties": {
          "fallback_reason": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "fallback_reason": {
            "type": "string"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "binding"
              ]
            },
            {
              "required": [
                "observation_cards"
              ]
            },
            {
              "required": [
                "current_evidence"
              ]
            },
            {
              "required": [
                "fixed_policy"
              ]
            },
            {
              "required": [
                "fact_rules"
              ]
            }
          ]
        }
      }
    }
  ]
}
