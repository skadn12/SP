{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "h4_r02_feedback_observation_v1",
  "title": "Deterministic model-safe historical Observation Cards",
  "type": "object",
  "required": [
    "common_base_version",
    "root_id",
    "feedback_status",
    "source_validation_status",
    "observation_cards"
  ],
  "additionalProperties": false,
  "properties": {
    "common_base_version": {
      "const": "h4_r02_feedback_common_base_v1"
    },
    "root_id": {
      "type": "string",
      "minLength": 1
    },
    "feedback_status": {
      "enum": [
        "ACTIVE_FEEDBACK",
        "NO_ACTIVE_FEEDBACK"
      ]
    },
    "source_validation_status": {
      "enum": [
        "PASS",
        "SOURCE_DRIFT"
      ]
    },
    "observation_cards": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/card"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "feedback_status": {
            "const": "NO_ACTIVE_FEEDBACK"
          }
        }
      },
      "then": {
        "properties": {
          "observation_cards": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "feedback_status": {
            "const": "ACTIVE_FEEDBACK"
          }
        }
      },
      "then": {
        "properties": {
          "observation_cards": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_count",
        "scored_count",
        "correct_count",
        "incorrect_count",
        "unknown_unscored_count",
        "unscored_or_unknown_count",
        "unknown_correctness_count",
        "canonical_prediction_counts"
      ],
      "properties": {
        "request_count": {
          "type": "integer",
          "minimum": 0
        },
        "scored_count": {
          "type": "integer",
          "minimum": 0
        },
        "correct_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "incorrect_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "unknown_unscored_count": {
          "type": "integer",
          "minimum": 0
        },
        "unscored_or_unknown_count": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_correctness_count": {
          "type": "integer",
          "minimum": 0
        },
        "canonical_prediction_counts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "prediction",
              "count"
            ],
            "additionalProperties": false,
            "properties": {
              "prediction": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              },
              "count": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "model": {
      "type": "object",
      "required": [
        "model_identity",
        "by_context"
      ],
      "additionalProperties": false,
      "properties": {
        "model_identity": {
          "type": "object",
          "required": [
            "model_name",
            "checkpoint_name"
          ],
          "additionalProperties": false,
          "properties": {
            "model_name": {
              "enum": [
                "M0",
                "M_clean_policy",
                "M_inclusive_policy"
              ]
            },
            "checkpoint_name": {
              "type": "string"
            },
            "checkpoint_identity_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "model_fingerprint_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "by_context": {
          "type": "object",
          "required": [
            "full_context",
            "no_context"
          ],
          "additionalProperties": false,
          "properties": {
            "full_context": {
              "$ref": "#/$defs/counts"
            },
            "no_context": {
              "$ref": "#/$defs/counts"
            }
          }
        }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_version",
        "root_id",
        "feedback_id",
        "source_candidate_id",
        "source_question_type",
        "source_question",
        "options",
        "items",
        "historical_gold",
        "gold_version",
        "source_quality_status",
        "review_status",
        "source_quality_caveat",
        "source_evidence_refs",
        "source_cluster_id",
        "source_cluster_status",
        "solver_observations",
        "provenance",
        "remaining_risks"
      ],
      "properties": {
        "observation_version": {
          "const": "h4_r02_feedback_observation_v1"
        },
        "root_id": {
          "type": "string",
          "minLength": 1
        },
        "feedback_id": {
          "type": "string",
          "minLength": 1
        },
        "source_candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "source_question_type": {
          "enum": [
            "single_choice",
            "multi_select"
          ]
        },
        "source_question": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "items": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "historical_gold": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "gold_version": {
          "type": "object",
          "required": [
            "id",
            "derived",
            "derivation"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "derived": {
              "type": "boolean"
            },
            "derivation": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "source_quality_status": {
          "const": "ACTIVE_GUIDANCE_ELIGIBLE"
        },
        "review_status": {
          "const": "REVIEWED_NO_CLEAR_GOLD_ERROR"
        },
        "source_quality_caveat": {
          "type": "string"
        },
        "source_evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "source_cluster_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_cluster_status": {
          "enum": [
            "EXPLICIT_FROZEN_SOURCE",
            "NOT_PROVIDED_IN_FROZEN_SOURCE"
          ]
        },
        "solver_observations": {
          "type": "object",
          "required": [
            "M0",
            "M_clean_policy",
            "M_inclusive_policy"
          ],
          "additionalProperties": false,
          "properties": {
            "M0": {
              "$ref": "#/$defs/model"
            },
            "M_clean_policy": {
              "$ref": "#/$defs/model"
            },
            "M_inclusive_policy": {
              "$ref": "#/$defs/model"
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "packet_sha256",
            "historical_candidate_sha256",
            "review_record_sha256",
            "details"
          ],
          "properties": {
            "packet_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "historical_candidate_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "review_record_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "details": {
              "const": "separate provenance sidecar"
            }
          }
        },
        "remaining_risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
