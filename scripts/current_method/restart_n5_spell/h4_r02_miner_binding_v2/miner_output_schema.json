{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intents",
    "feedback_bindings"
  ],
  "properties": {
    "intents": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "intent_id",
          "intent_type",
          "reasoning_chain",
          "discriminative_variable",
          "candidate_question_types"
        ],
        "properties": {
          "intent_id": {
            "type": "string",
            "minLength": 1,
            "description": "A unique explicit ID for this intent."
          },
          "intent_type": {
            "type": "string",
            "enum": [
              "causal_chain",
              "decision_boundary",
              "necessary_evidence",
              "state_transition",
              "temporal_evolution"
            ]
          },
          "reasoning_chain": {
            "type": "object",
            "required": [
              "before_state",
              "trigger",
              "after_state"
            ],
            "properties": {
              "before_state": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": "Actual 1-based positions in the numbered current dialogue; groups must be non-empty and disjoint."
              },
              "trigger": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": "Actual 1-based positions in the numbered current dialogue; groups must be non-empty and disjoint."
              },
              "after_state": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": "Actual 1-based positions in the numbered current dialogue; groups must be non-empty and disjoint."
              }
            }
          },
          "discriminative_variable": {
            "type": "string",
            "minLength": 1,
            "description": "The concrete distinction to test, not a topic."
          },
          "candidate_question_types": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "enum": [
                "single_choice",
                "multi_select",
                "ordering"
              ]
            }
          }
        }
      }
    },
    "feedback_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "change_from_source",
          "intent_id",
          "scope",
          "source_feedback_ids",
          "status"
        ],
        "properties": {
          "intent_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "PROPOSED_TRANSFER",
              "NO_SUPPORTED_TRANSFER"
            ]
          },
          "source_feedback_ids": {
            "type": "array",
            "maxItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "scope": {
            "type": "string"
          },
          "change_from_source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "added_distinction",
              "feedback_basis",
              "old_question_focus"
            ],
            "properties": {
              "added_distinction": {
                "type": "string"
              },
              "feedback_basis": {
                "type": "string"
              },
              "old_question_focus": {
                "type": "string"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "PROPOSED_TRANSFER"
                }
              }
            },
            "then": {
              "properties": {
                "source_feedback_ids": {
                  "minItems": 1
                },
                "scope": {
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "change_from_source": {
                  "properties": {
                    "added_distinction": {
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "feedback_basis": {
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "old_question_focus": {
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "source_feedback_ids": {
                  "maxItems": 0
                },
                "scope": {
                  "const": ""
                },
                "change_from_source": {
                  "properties": {
                    "added_distinction": {
                      "const": ""
                    },
                    "feedback_basis": {
                      "const": ""
                    },
                    "old_question_focus": {
                      "const": ""
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "description": "One binding for each explicitly identified original intent. Explanations require separate offline review."
    }
  }
}
